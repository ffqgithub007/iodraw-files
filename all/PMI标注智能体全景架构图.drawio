        <mxCell id="S4XG45Wahda2dK0s9bxt-59" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontColor=#0d47a1;fontSize=13;fontFamily=PingFang SC;align=center;" value="&lt;b&gt;2. 标注样例模板 (XML)&lt;/b&gt;" vertex="1">
