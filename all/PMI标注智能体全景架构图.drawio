        <mxCell id="S4XG45Wahda2dK0s9bxt-60" parent="1" style="text;html=1;strokeColor=none;fillColor=#e8eaf6;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#1a237e;fontFamily=PingFang SC;rounded=1;strokeWidth=1;strokeColor=#3949ab;" value="&lt;font face=&quot;Courier New&quot; size=&quot;10&quot;&gt;&lt;b&gt;&amp;lt;AnnotationTemplate&amp;gt;&lt;/b&gt;\n  &lt;b&gt;&amp;lt;Dimension&amp;gt;&lt;/b&gt;\n    &amp;lt;Type&amp;gt;DL&amp;lt;/Type&amp;gt;      &lt;!-- 线性标注 --&gt;\n    &amp;lt;Value&amp;gt;20.5&amp;lt;/Value&amp;gt;    &lt;!-- 尺寸值 --&gt;\n    &amp;lt;Object1&amp;gt;Face.1&amp;lt;/Object1&amp;gt; &lt;!-- 标注对象1 --&gt;\n    &amp;lt;Object2&amp;gt;Face.2&amp;lt;/Object2&amp;gt; &lt;!-- 标注对象2 --&gt;\n    &amp;lt;Location&amp;gt; &lt;!-- 位置信息 --&gt;\n      &amp;lt;Box_X&amp;gt;120.0&amp;lt;/Box_X&amp;gt;\n      &amp;lt;Box_Y&amp;gt;85.0&amp;lt;/Box_Y&amp;gt;\n      &amp;lt;Ref_Line&amp;gt;Pitch_Line_3&amp;lt;/Ref_Line&amp;gt;\n    &amp;lt;/Location&amp;gt;\n  &lt;b&gt;&amp;lt;/Dimension&amp;gt;&lt;/b&gt;\n&lt;b&gt;&amp;lt;/AnnotationTemplate&amp;gt;&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="520" x="620" y="2596" as="geometry" />
        </mxCell>
        <mxCell id="S4XG45Wahda2dK0s9bxt-61" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontColor=#0d47a1;fontSize=13;fontFamily=PingFang SC;align=center;" value="&lt;b&gt;3. 标注规则与标准&lt;/b&gt;" vertex="1">
